# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Where the MCP server reaches Immich. Use the container name if this stack
# shares Immich's Docker network, otherwise the NAS LAN address.
#   same network : http://immich_server:2283
#   LAN          : http://192.168.1.50:2283
IMMICH_URL=http://192.168.0.43:2283

# Immich > Account Settings > API Keys > New API Key.
# Scope it read-only unless you enable share links below.
IMMICH_API_KEY= "Hshvib10bzgN5ZkuphTA1Wl8qKHEfqs5A16ug6ywFgI"

# Shared secret ChatGPT sends as "Authorization: Bearer <token>".
# Generate with:  openssl rand -hex 32
MCP_BEARER_TOKEN=6b0111dca17ef4d27304868a05d0e47b267b8eb03256c1ff824373c09abb8a0b

# Restrict access to specific albums. Leave EMPTY to expose the whole library.
# Comma-separated album UUIDs. Discover them with:  python list_albums.py
#
# When set, every tool is confined to assets inside these albums: search,
# metadata filters, people, and direct fetch by UUID all refuse anything else.
# This is the cleanest way to share a subset of your photos with ChatGPT.
#
#   ALLOWED_ALBUM_IDS=a1b2c3d4-1111-2222-3333-444455556666
ALLOWED_ALBUM_IDS=

# Seconds before the scoped asset list is rebuilt, picking up newly added
# photos. Lower means fresher, at the cost of more calls to Immich.
SCOPE_TTL=300

# Public browser-facing Immich URL, used to build clickable links in results.
# Leave blank to omit URLs entirely.
PUBLIC_URL=

# Allow the model to mint public share links for specific photos.
# These links are viewable by ANYONE who has the URL, with no login.
# Keep false unless you actually want ChatGPT able to surface images.
ALLOW_SHARE_LINKS=false

# --- Tuning (optional) -----------------------------------------------------
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
HTTP_TIMEOUT=30
STATELESS_HTTP=true
LOG_LEVEL=INFO
